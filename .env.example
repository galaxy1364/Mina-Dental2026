# Supabase cloud config (public client keys — safe to expose in the app bundle).
# Copy to .env and fill in. Get values from Supabase: Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
EXPO_PUBLIC_APP_ENV=development
